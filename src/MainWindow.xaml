<Window x:Class="DiskLens.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DiskLens"
        Style="{StaticResource {x:Type Window}}" Title="盘镜 · DiskLens" Icon="DiskLens.ico" Width="1280" Height="820" MinWidth="880" MinHeight="585"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown" Closing="Window_Closing">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="61"/><RowDefinition Height="*"/><RowDefinition Height="39"/></Grid.RowDefinitions>
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="19,0">
            <DockPanel LastChildFill="True">
                <Button x:Name="SettingsButton" DockPanel.Dock="Right" Click="Settings_Click" VerticalAlignment="Center" Margin="12,0,0,0" Content="✦   AI 设置"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Fill="{StaticResource AccentBrush}" Width="7" Height="7" Margin="0,1,7,0"/>
                    <TextBlock Text="本地优先" Style="{StaticResource Muted}" FontSize="12"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="10" Width="36" Height="36" Margin="0,0,11,0">
                        <Path Data="M 1,1 H 9 V 16 H 1 Z M 12,1 H 21 V 7 H 12 Z M 12,10 H 21 V 16 H 12 Z"
                              Fill="#0C332C" Width="20" Height="15" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="盘镜" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="DiskLens" Margin="9,3,0,0" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="213"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="13,15,13,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="5,0,5,9">
                        <TextBlock Text="VOLUMES" Style="{StaticResource Overline}" Foreground="{StaticResource AccentBrush}"/>
                        <DockPanel Margin="0,4,0,0">
                            <Button x:Name="RefreshDrivesButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="⟳" Click="RefreshDrives_Click"
                                    Padding="8,1" MinHeight="24" ToolTip="刷新磁盘列表" AutomationProperties.Name="刷新磁盘列表"/>
                            <TextBlock Text="磁盘与位置" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="选择磁盘即可浏览和移动" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Background="#102A2A" BorderBrush="#22463F" BorderThickness="1" CornerRadius="10" Padding="11" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="◈   扫描只读" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="不跟随链接和离线项；文件操作需要手动选择与确认。" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DriveList">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Click="Drive_Click" HorizontalContentAlignment="Stretch" Padding="10" Margin="0,3,0,5" Background="{StaticResource PanelBrush}"
                                        AutomationProperties.Name="{Binding Root}" ToolTip="{Binding Caption}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Letter}" FontWeight="Bold" FontSize="17" Foreground="{StaticResource AccentBrush}" Margin="0,0,9,0"/>
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Height="4" Margin="0,8,0,7"/>
                                        <TextBlock Text="{Binding Caption}" FontSize="11" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="18,14,18,12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0,0,0">
                        <Button x:Name="RescanButton" Click="Rescan_Click" Style="{StaticResource GhostButton}" Content="全量重扫" Margin="0,0,4,0"
                                ToolTip="重新扫描整个范围；丢弃当前增量缓存"/>
                        <Button x:Name="RefreshButton" Click="Refresh_Click" Content="⟳  刷新" Margin="0,0,7,0"
                                ToolTip="刷新本次扫描（F5）；优先更新变更目录，并重试无访问权限的位置"/>
                        <Button x:Name="PickButton" Style="{StaticResource PrimaryButton}" Click="Pick_Click" Content="＋  选择文件夹"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="SPACE EXPLORER" Style="{StaticResource Overline}" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="磁盘空间分析" FontSize="25" FontWeight="Bold" Margin="0,1,0,0"/>
                        <TextBlock x:Name="ScopeText" Text="选择磁盘或文件夹即可移动；需要统计空间时再扫描。" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
                <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,11">
                    <Border Margin="0,0,7,0" Background="#102B32" BorderBrush="#265058" BorderThickness="1" CornerRadius="11" Padding="12,8">
                        <StackPanel><TextBlock Text="已扫描空间" Style="{StaticResource Overline}"/>
                            <TextBlock x:Name="MetricSize" Text="—" Foreground="{StaticResource AccentBrush}" FontSize="23" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="MetricSizeDetail" Text="文件逻辑大小之和" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,7,0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="12,8">
                        <StackPanel><TextBlock Text="已扫描文件" Style="{StaticResource Overline}"/>
                            <TextBlock x:Name="MetricFiles" Text="—" Foreground="{StaticResource IndigoBrush}" FontSize="23" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="MetricFileDetail" Text="文件夹数将同时统计" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="12,8">
                        <StackPanel><TextBlock Text="所在盘可用空间" Style="{StaticResource Overline}"/>
                            <TextBlock x:Name="MetricFree" Text="—" FontSize="23" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="MetricFreeDetail" Text="来自 Windows 容量统计" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="10,7,10,9" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="118"/></Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="点击色块进入文件夹或定位文件" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="空间地图" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <local:Treemap x:Name="SpaceMap" Grid.Row="1" Focusable="False"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="3" Margin="0,0,0,7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="145"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="UpButton" Click="Up_Click" Content="↑  上一级" Margin="0,0,6,0"/>
                    <TextBox x:Name="PathBox" Grid.Column="1" IsReadOnly="True" Text="尚未扫描" Margin="0,0,7,0" VerticalContentAlignment="Center"
                             ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" AutomationProperties.Name="当前文件夹路径"/>
                    <Grid Grid.Column="2" Margin="0,0,5,0">
                        <TextBox x:Name="SearchBox" KeyDown="Search_KeyDown" VerticalContentAlignment="Center" AutomationProperties.Name="按名称搜索"/>
                        <TextBlock Text="按名称搜索" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                </Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button x:Name="SearchButton" Grid.Column="3" Click="Search_Click" Content="搜索" ToolTip="在整个扫描范围搜索（Ctrl+F）"/>
                </Grid>
                <DockPanel Grid.Row="4" Margin="0,0,0,7">
                    <TextBlock x:Name="ViewLabel" DockPanel.Dock="Left" Text="文件列表" Style="{StaticResource SectionTitle}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                    <Button x:Name="BackToFolderButton" DockPanel.Dock="Left" Click="BackToFolder_Click" Content="返回目录" Margin="0,0,6,0" Visibility="Collapsed"/>
                    <WrapPanel HorizontalAlignment="Right">
                        <Button x:Name="RevealButton" Click="Reveal_Click" Content="打开位置" Margin="0,0,5,0"/>
                        <Button x:Name="MoveButton" Click="Move_Click" Content="移动" Margin="0,0,5,0"/>
                        <Button x:Name="RecycleButton" Click="Recycle_Click" Content="移到回收站" Style="{StaticResource DangerButton}" Margin="0,0,5,0"/>
                        <Button x:Name="DeleteButton" Click="Delete_Click" Content="彻底删除" Style="{StaticResource DangerButton}"
                                ToolTip="不经过回收站；需另行确认" Margin="0,0,5,0"/>
                        <Button x:Name="DuplicateButton" Click="Duplicates_Click" Content="本地查重" ToolTip="在当前目录及其子目录查找内容重复的文件" Margin="0,0,5,0"/>
                        <Button x:Name="AiButton" Click="Ai_Click" Content="✦  AI 建议" Foreground="{StaticResource IndigoBrush}"/>
                    </WrapPanel>
                </DockPanel>
                <Border Grid.Row="5" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <Grid>
                        <DataGrid x:Name="Entries" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserReorderColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  Background="Transparent" BorderThickness="0" GridLinesVisibility="None" RowHeight="32" ColumnHeaderHeight="32"
                                  HeadersVisibility="Column" SelectionUnit="FullRow" SelectionMode="Extended" ScrollViewer.CanContentScroll="True"
                                  MouseDoubleClick="Entries_DoubleClick" SelectionChanged="Entries_SelectionChanged" Sorting="Entries_Sorting"
                                  AutomationProperties.Name="扫描结果">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="GroupColumn" Header="重复组" Width="75" Visibility="Collapsed" Binding="{Binding GroupLabel}" SortMemberPath="GroupLabel" ElementStyle="{StaticResource TableText}"/>
                                <DataGridTemplateColumn Header="名称" Width="*" MinWidth="140" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <DockPanel LastChildFill="True">
                                            <Viewbox DockPanel.Dock="Left" Width="14" Height="13" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Path Stroke="{StaticResource IndigoBrush}" StrokeThickness="1.35" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                    <Path.Style><Style TargetType="Path">
                                                        <Setter Property="Data" Value="M 2,1 H 9 L 13,5 V 15 H 2 Z M 9,1 V 5 H 13"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding Item.IsDirectory}" Value="True">
                                                            <Setter Property="Data" Value="M 1,13 V 3 H 7 L 9,5 H 15 V 13 Z"/>
                                                        </DataTrigger></Style.Triggers>
                                                    </Style></Path.Style>
                                                </Path>
                                            </Viewbox>
                                            <TextBlock Text="{Binding Item.Name}" Style="{StaticResource TableText}"/>
                                        </DockPanel>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn x:Name="PathColumn" Header="所在目录" Width="*" MinWidth="125" Visibility="Collapsed" Binding="{Binding Item.Parent.FullPath}" SortMemberPath="Path" ElementStyle="{StaticResource TableText}"/>
                                <DataGridTextColumn x:Name="SizeColumn" Header="逻辑大小" Width="109" Binding="{Binding Item.SizeText}" SortMemberPath="Size" ElementStyle="{StaticResource TableText}"/>
                                <DataGridTemplateColumn Header="占父目录" Width="101" SortMemberPath="Share">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <StackPanel><TextBlock Text="{Binding Item.ShareText}" FontSize="11" Style="{StaticResource Muted}"/>
                                            <ProgressBar Value="{Binding Item.Share, Mode=OneWay}" Height="3" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="类型" Width="99" Binding="{Binding Item.Kind}" SortMemberPath="Kind" ElementStyle="{StaticResource TableText}"/>
                                <DataGridTextColumn Header="修改时间" Width="137" Binding="{Binding Item.ModifiedText}" SortMemberPath="Modified" ElementStyle="{StaticResource TableText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="EmptyLabel" Text="还没有扫描结果" IsHitTestVisible="False" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,23,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,0">
            <DockPanel LastChildFill="True">
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="取消任务" Visibility="Collapsed" Click="Cancel_Click" VerticalAlignment="Center" MinHeight="27" Padding="9,3"/>
                <Button x:Name="IssuesButton" DockPanel.Dock="Right" Content="扫描详情" Style="{StaticResource GhostButton}" Click="Issues_Click" VerticalAlignment="Center" MinHeight="27" Padding="9,3"/>
                <Button x:Name="FileTasksButton" DockPanel.Dock="Right" Content="文件任务" Style="{StaticResource GhostButton}"
                        Visibility="Collapsed" Click="FileTasks_Click" VerticalAlignment="Center" MinHeight="27" Padding="9,3"/>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" MaxWidth="470" Text="就绪 · 不会自动扫描或清理" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                </StackPanel>
                <TextBlock x:Name="SelectionText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="14,0,10,0" Style="{StaticResource Muted}"
                           ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
