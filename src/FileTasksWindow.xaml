<Window x:Class="DiskLens.FileTasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="文件任务 · 盘镜" Width="820" Height="620" MinWidth="620" MinHeight="380"
        WindowStartupLocation="CenterOwner">
    <Grid Background="{StaticResource BackgroundBrush}">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <DockPanel>
                <Button x:Name="HistoryButton" DockPanel.Dock="Right" Content="提交记录" Click="History_Click" />
                <TextBlock Text="文件任务" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="CountsText" Margin="0,7,0,7" Foreground="{StaticResource AccentBrush}"/>
            <DockPanel>
                <TextBlock Text="同时执行" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="ParallelBox" Width="80" HorizontalAlignment="Left" SelectionChanged="Parallel_Changed"
                          IsEditable="False" Foreground="#17263A"/>
                <TextBlock Text="降低并行数不打断已开始的任务；其余按顺序排队。"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}"/>
            </DockPanel>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                   Text="时间按近期实际进度估算，并非保证值；统计目录、等待确认或进度停滞时暂不估时。关闭此面板不停止任务，可继续浏览或添加任务，完成后手动刷新。"/>
        <Grid>
            <TextBlock x:Name="EmptyText" Text="尚无文件任务" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"/>
            <ListBox x:Name="TaskList" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,9"/>
                        <Setter Property="Template">
                            <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="15">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="详情" Tag="{Binding}" Click="Details_Click" Margin="10,0,0,0"/>
                                    <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" ToolTip="{Binding Label}"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Target}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}"
                                           Margin="0,5,0,7" Foreground="{StaticResource MutedBrush}"/>
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Percentage}" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="{Binding Phase}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                             IsIndeterminate="{Binding Indeterminate}"/>
                                <TextBlock Text="{Binding Timing}" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Transfer}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
    </Grid>
</Window>
